# Server environment (copy to .env — never commit .env)
API_PORT=4000
DATABASE_PATH=./database/mathlab.db
SESSION_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# Optional AI tutor (OpenAI-compatible). Never expose these in the frontend.
TUTOR_API_KEY=
TUTOR_API_BASE=https://api.openai.com/v1
TUTOR_MODEL=gpt-4o-mini
NODE_ENV=development
